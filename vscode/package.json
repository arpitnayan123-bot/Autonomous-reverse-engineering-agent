{
  "name": "area-vscode",
  "displayName": "AREA Platform",
  "description": "Connect Visual Studio Code to your self-hosted AREA platform: browse projects, targets and chats, analyze the current file, and ask @area in Copilot Chat.",
  "version": "0.1.0",
  "publisher": "arpit-nayan",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "area",
    "security",
    "analysis",
    "chatbot",
    "reverse engineering"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "AREA",
      "properties": {
        "area.baseUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "markdownDescription": "Base URL of the self-hosted AREA instance to connect to, e.g. `https://area.example.com`. The extension authenticates against this URL and stores the session token in VS Code secret storage."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "area-explorer",
          "title": "AREA",
          "icon": "media/area.svg"
        }
      ]
    },
    "views": {
      "area-explorer": [
        {
          "id": "area.explorer",
          "name": "Explorer",
          "contextualTitle": "AREA"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "area.explorer",
        "contents": "Connect VS Code to your self-hosted AREA platform to browse projects, targets and investigation chats.\n[Sign in to AREA](command:area.login)\nOr [check the connection](command:area.reconnect) if you already have a session.\nSet the instance URL via the `area.baseUrl` setting."
      }
    ],
    "commands": [
      {
        "command": "area.login",
        "title": "Sign In",
        "category": "AREA"
      },
      {
        "command": "area.logout",
        "title": "Sign Out",
        "category": "AREA"
      },
      {
        "command": "area.reconnect",
        "title": "Reconnect",
        "category": "AREA"
      },
      {
        "command": "area.refresh",
        "title": "Refresh Explorer",
        "category": "AREA",
        "icon": "$(refresh)"
      },
      {
        "command": "area.newChat",
        "title": "New Chat",
        "category": "AREA"
      },
      {
        "command": "area.analyzeCurrentFile",
        "title": "Analyze Current File",
        "category": "AREA"
      },
      {
        "command": "area.openChat",
        "title": "Open Chat",
        "category": "AREA"
      },
      {
        "command": "area.analyzeTarget",
        "title": "Analyze Target",
        "category": "AREA"
      },
      {
        "command": "area.setActiveProject",
        "title": "Set as Active Project",
        "category": "AREA"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "area.refresh",
          "when": "view == area.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "area.setActiveProject",
          "when": "view == area.explorer && viewItem == areaProject",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "area.openChat",
          "when": "false"
        },
        {
          "command": "area.analyzeTarget",
          "when": "false"
        },
        {
          "command": "area.setActiveProject",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.5.4"
  }
}
