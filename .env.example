# AREA platform environment (copy to .env and adjust)
# Database (SQLite via Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Encryption secret for the BYOK provider vault (falls back to a generated
# runtime secret if unset — set it in production to survive restarts)
# AREA_VAULT_SECRET=change-me-64-chars

# Command sandbox (workspace command execution)
# AREA_SANDBOX_IMAGE=node:20-alpine

# Browser probe (Chromium path override; auto-detected otherwise)
# AREA_BROWSER_PATH=/usr/bin/chromium

# Outbound MCP server (scripts/mcp-server.ts)
# AREA_MCP_URL=http://127.0.0.1:3000
# AREA_MCP_TOKEN=<user area_session cookie>
# AREA_EMAIL=you@example.com        # used by scripts/mcp-token.ts
# AREA_PASSWORD=...

# Optional GitHub API auth for research (raises rate limits)
# GITHUB_TOKEN=

# Public site URL (meta/OG tags)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
