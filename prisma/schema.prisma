generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  passwordHash String
  role         String           @default("analyst")
  isDemo       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  targets      Target[]
  chatSessions ChatSession[]
  providerKey  ProviderKey?
  authSessions AuthSession[]
  projects     Project[]
  connectors   Connector[]
  preference   UserPreference?
}

/**
 * Per-user platform preferences (one row per user, created lazily on first
 * write). Typed columns instead of JSON because the SQLite provider has no
 * JSON column type. `sandboxMode` selects how chat-workspace commands run:
 *   auto    — Docker container sandbox when a daemon is reachable, else the
 *             process-level jail (platform default)
 *   process — always the process-level jail (pre-Docker behavior)
 *   docker  — always the container sandbox; refused honestly when Docker is
 *             unavailable (the command is NOT executed)
 */
model UserPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandboxMode String   @default("auto") // "auto" | "process" | "docker"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Revocable server-side session records. The cookie token carries the session
 * id (sid); every authenticated request checks it against this table, so
 * logout (and "sign out other sessions") immediately invalidates outstanding
 * cookies — the previous stateless HMAC tokens could not be revoked at all.
 */
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId, revokedAt])
}

model Target {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName   String
  storedPath     String
  sizeBytes      Int
  sha256         String
  mimeType       String?
  detectedFormat String?
  formatFamily   String?
  status         String        @default("uploaded")
  summary        String?
  docs           String?
  docsAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  runs           AnalysisRun[]
  chatSessions   ChatSession[]

  @@index([userId, createdAt])
}

model AnalysisRun {
  id           String     @id @default(cuid())
  targetId     String
  target       Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status       String     @default("queued")
  progress     Int        @default(0)
  currentStep  String?
  engine       String     @default("rea")
  engineTools  String?
  goal         String?
  result       String?
  error        String?
  durationMs   Int?
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?
  evidence     Evidence[]
  findings     Finding[]

  @@index([targetId, createdAt])
}

model Evidence {
  id            String      @id @default(cuid())
  runId         String
  run           AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidenceId    String?
  kind          String
  predicateType String?
  operation     String?
  subjectName   String?
  confidence    String?
  authority     String?
  payload       String
  createdAt     DateTime    @default(now())

  @@index([runId])
}

model Finding {
  id        String      @id @default(cuid())
  runId     String
  run       AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  type      String
  name      String
  address   String?
  sizeBytes Int?
  meta      String?
  createdAt DateTime    @default(now())

  @@index([runId, type])
  @@index([type, name])
}

model ChatSession {
  id        String   @id @default(cuid())
  targetId  String?
  target    Target?  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New investigation")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  messages  ChatMessage[]

  @@index([userId, pinned, updatedAt])
  @@index([targetId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  content    String
  toolCalls  String?
  /** Prompt tokens reported by the provider (assistant rows, null = unknown). */
  tokensIn   Int?
  /** Completion tokens reported by the provider (assistant rows, null = unknown). */
  tokensOut  Int?
  /** Wall-clock duration of the whole agent turn, in ms (assistant rows). */
  durationMs Int?
  /**
   * Canonical model id that produced this assistant row, e.g.
   * "openai/gpt-4o-mini" (BYOK) or "glm-platform" — kept per message so cost
   * estimates and model chips stay correct when the provider changes mid-session.
   */
  modelId    String?
  /**
   * How many times context compaction ran during this agent turn
   * (assistant rows; 0 = none) — surfaced in the transcript meta.
   */
  compactions Int?
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model ProviderKey {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  model     String
  keyCipher String
  keyIv     String
  keyTag    String
  keyLast4  String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  ip        String?
  severity  String   @default("info")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Universal Software Intelligence & Reconstruction Platform
// ---------------------------------------------------------------------------

/**
 * A Project is the subject of a full DISCOVER→VERIFY investigation: a website,
 * a GitHub repository, or an uploaded target. Everything the eight platform
 * capabilities produce (crawled pages, graph nodes, research, builds,
 * orchestrations, verifications) hangs off a Project.
 */
model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         String // "website" | "github" | "file"
  reference    String // https URL, "owner/repo", or targets/<id>
  description  String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pages        CrawlPage[]
  nodes        GraphNode[]
  edges        GraphEdge[]
  reports      ResearchReport[]
  artifacts    BuildArtifact[]
  orchestrations Orchestration[]
  verifications  VerificationRun[]

  @@index([userId, updatedAt])
}

/** One crawled page of a website project (explorer output, untrusted data). */
model CrawlPage {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String
  status      Int // HTTP status code (0 = fetch error)
  title       String?
  description String?
  textExcerpt String? // bounded plain-text extraction
  links       String? // JSON [{href,text}]
  tech        String? // JSON [fingerprint strings]
  depth       Int      @default(0)
  contentHash String?
  fetchedAt   DateTime @default(now())

  @@unique([projectId, url])
  @@index([projectId])
}

/**
 * Knowledge-graph node. Deduplicated per project by (kind,key). Provenance
 * follows the evidence ledger: OBSERVED | DERIVED | INFERRED | UNKNOWN.
 */
model GraphNode {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       String // page|asset|api|endpoint|component|service|model|tech|function|class|finding
  key        String // stable identity: URL, symbol path, name
  label      String
  meta       String? // JSON details
  provenance String   @default("OBSERVED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, kind, key])
  @@index([projectId, kind])
}

/** Typed, directed graph edge between two nodes (referenced by node keys). */
model GraphEdge {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromKind   String
  fromKey    String
  toKind     String
  toKey      String
  kind       String // links-to|calls|imports|serves|depends-on|contains|references
  meta       String?
  provenance String   @default("OBSERVED")
  createdAt  DateTime @default(now())

  @@unique([projectId, fromKind, fromKey, toKind, toKey, kind])
  @@index([projectId])
}

/** A cited research report produced for a project. */
model ResearchReport {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  query     String
  summary   String?
  reportMd  String?
  sources   String? // JSON [{title,url,snippet,kind}]
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/** A file (or log/plan) materialized in the builder's isolated workspace. */
model BuildArtifact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String // workspace-relative
  content   String?
  kind      String   @default("file") // file|log|plan
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/**
 * One run of the full reconstruction pipeline. Steps form a DAG persisted in
 * OrchestrationStep; retries, checkpoints, approvals and cancellation live on
 * the step rows.
 */
model Orchestration {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal         String
  status       String    @default("running") // running|completed|failed|cancelled|awaiting_approval
  currentStage String?
  progress     Int       @default(0)
  error        String?
  context      String? // JSON shared context across steps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  finishedAt   DateTime?
  steps        OrchestrationStep[]

  @@index([projectId, createdAt])
}

model OrchestrationStep {
  id              String        @id @default(cuid())
  orchestrationId String
  orchestration   Orchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  stage           String // discover|collect|understand|map|research|plan|build|test|verify
  name            String
  status          String        @default("pending") // pending|running|done|failed|skipped|awaiting_approval|cancelled
  attempts        Int           @default(0)
  maxAttempts     Int           @default(2)
  dependsOn       String? // JSON array of step ids
  output          String? // JSON result payload
  checkpoint      String? // JSON resume point
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?

  @@index([orchestrationId])
}

/** One verification pass: HTTP/browser checks, score, diff, regression flag. */
model VerificationRun {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String?
  status      String   @default("completed")
  score       Int? // 0-100
  checks      String? // JSON [{name,passed,detail,ms}]
  diffSummary String?
  regression  Boolean?
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

/**
 * Cross-session persistent memory for the agent. Rows are scoped per user:
 * targetId = null → GLOBAL (recalled in every chat of this user, including
 * free chats); otherwise the memory belongs to that one target and is only
 * recalled in chats on it. Plain columns (no FK) by design — memories are
 * authored by the agent from chat context, may use synthetic ids in tests,
 * and global knowledge must survive target deletion (orphaned target rows
 * simply become unreachable). Uniqueness is enforced in application code
 * (remember() upserts on userId+targetId+key) because SQLite treats NULLs
 * as distinct in unique indexes, which would break global-scope upserts.
 */
model Memory {
  id        String   @id @default(cuid())
  userId    String
  targetId  String?
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, targetId, updatedAt])
  @@index([userId, key])
}

/**
 * A reusable external capability: built-in platform services, plain HTTP
 * endpoints, or MCP servers. Header secrets are sealed with the same
 * AES-256-GCM vault as provider keys.
 */
model Connector {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  kind          String // builtin|http|mcp
  endpoint      String? // URL (http) or command (mcp stdio)
  config        String? // JSON: builtin id / method / tool mapping
  sealedHeaders String? // JSON SealedKey[] for auth headers
  status        String    @default("unknown") // unknown|healthy|unreachable
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
